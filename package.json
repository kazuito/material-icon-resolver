{
  "name": "material-icon-resolver",
  "version": "0.1.4",
  "description": "Resolve Material Icon Theme icon names, filenames, and CDN URLs from a file path, folder path, or language ID.",
  "author": "kazuito",
  "license": "MIT",
  "homepage": "https://github.com/kazuito/material-icon-resolver#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazuito/material-icon-resolver.git"
  },
  "bugs": {
    "url": "https://github.com/kazuito/material-icon-resolver/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./file": {
      "import": {
        "types": "./dist/file.d.mts",
        "default": "./dist/file.mjs"
      },
      "require": {
        "types": "./dist/file.d.cts",
        "default": "./dist/file.cjs"
      }
    },
    "./folder": {
      "import": {
        "types": "./dist/folder.d.mts",
        "default": "./dist/folder.mjs"
      },
      "require": {
        "types": "./dist/folder.d.cts",
        "default": "./dist/folder.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "file": [
        "./dist/file.d.cts"
      ],
      "folder": [
        "./dist/folder.d.cts"
      ]
    }
  },
  "keywords": [
    "material-icon-theme",
    "icons",
    "vscode",
    "file-icons",
    "folder-icons"
  ],
  "scripts": {
    "build": "tsdown",
    "generate": "tsx scripts/generate.ts",
    "validate-icons": "tsx scripts/validate-icons.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "pnpm biome check --write && pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.6.0",
    "husky": "^9.1.7",
    "tsdown": "^0.21.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
