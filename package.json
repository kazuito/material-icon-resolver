{
	"name": "material-icon-resolver",
	"version": "0.1.1",
	"description": "Resolve VS Code Material Icon Theme icon names, SVG filenames, and CDN URLs from file or folder paths.",
	"author": "kazuito",
	"license": "MIT",
	"homepage": "https://github.com/kazuito/material-icon-resolver#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kazuito/material-icon-resolver.git"
	},
	"bugs": {
		"url": "https://github.com/kazuito/material-icon-resolver/issues"
	},
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"keywords": [
		"material-icon-theme",
		"icons",
		"vscode",
		"file-icons",
		"folder-icons"
	],
	"scripts": {
		"build": "tsdown",
		"generate": "tsx scripts/generate.ts",
		"validate-icons": "tsx scripts/validate-icons.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint",
		"format": "biome format --write",
		"prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
		"prepare": "husky"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@types/node": "^25.6.0",
		"husky": "^9.1.7",
		"tsdown": "^0.21.10",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	}
}
